family jig-store-core 1

record ProposerTask { value: u64 }
record ProposerParty { value: u64 }
enum Proposer { task: ProposerTask, party: ProposerParty }
enum ProposalChoice { accepted, rejected, passed, withdrawn, stale }
record EscalationDecisionReject { reason: bytes 8192 }
enum EscalationDecision { release, reject: EscalationDecisionReject, pass }
enum ProposalKind { batch, effect, amend, widen, release }
record EscalationOutcomePassed { revision: u64 }
enum EscalationOutcome { released, rejected, passed: EscalationOutcomePassed, stale, no_further, limit }
enum ProposalOutcome { accepted, rejected, passed, withdrawn, stale }
enum Source { task, role, project, deployment }
record Lacks { tools: bool grants: bool executors: bool tasks: bool depth: bool spend: bool deadline: bool notes: bool }
record Judge { connector: u16 requirement: u16 parameters: u32 }
enum Answer { allow, wait, propose, refuse }
record FindingAuthority { source: Source lacks: Lacks }
record FindingExecutor { source: Source }
record FindingTasks { source: Source }
record FindingSpend { source: Source }
record FindingGrant { source: Source }
record FindingPrice { source: Source }
record FindingScope { source: Source }
record FindingRequired { judge: Judge }
record FindingFailed { judge: Judge }
record FindingUnguarded { judge: Judge }
enum Finding { oversized, unknown_project, unknown_role, authority: FindingAuthority, executor: FindingExecutor, tasks: FindingTasks, spend: FindingSpend, arithmetic, run_budget, run_cap, deadline, account, writer, tool, grant: FindingGrant, price: FindingPrice, resource_access, resource_unavailable, reference, scope: FindingScope, required: FindingRequired, failed: FindingFailed, unguarded: FindingUnguarded, unpermitted, undecidable, period_spend }
enum HostKind { worker, engine }
record OutboxOutcomeHeld { entry: u64 }
enum OutboxOutcome { made, failed, withdrawn, not_made, uncertain, held: OutboxOutcomeHeld }
enum DeliveryOutcome { delivered, nothing, stale, refused, invalid, failed }
record SettledAnswerHost { error: bool body: bytes 8192 }
record SettledAnswerDelivery { outcome: DeliveryOutcome evidence: bytes 8192 }
enum SettledAnswer { host: SettledAnswerHost, delivery: SettledAnswerDelivery }
record SettledCall { serial: u64 name: bytes 8192 tool: bytes 8192 answer: SettledAnswer }
record CallKey { task: u64 attempt: u64 completion: u32 position: u32 }
record CallPartEffect { connector: u16 entry: u64 deadline: u64 outcome: option OutboxOutcome }
record CallPartConnector { connector: u16 }
record CallPartEffectDenied { answer: Answer findings: list 1024 Finding }
record CallPartToolDenied { answer: Answer findings: list 1024 Finding }
record CallPartEscalationDecided { task: u64 revision: u64 outcome: EscalationOutcome }
record CallPartProposed { proposal: u64 }
record CallPartProposalDecided { proposal: u64 outcome: ProposalOutcome }
record CallPartControlDenied { answer: Answer }
record CallPartSent { message: u64 }
record CallPartSubscribed { subscription: u64 }
record CallPartDelegationDenied { answer: Answer findings: list 1024 Finding }
record CallPartNoteWritten { name: u64 revision: u32 }
record TaskBytes { value: bytes 8192 }
record CallPartEscalationRefused { value: TaskBytes }
record CallPartProposalRefused { value: TaskBytes }
record CallPartControlRefused { value: TaskBytes }
record CallPartMessageRefused { value: TaskBytes }
record CallPartSubscriptionRefused { value: TaskBytes }
record CallPartDelegationRefused { value: TaskBytes }
record Number { value: u64 }
record CallPartDelegated { value: list 1024 Number }
record NoteBytes { value: bytes 2097152 }
record CallPartNoteRecalled { entries: list 16 NoteBytes more: bool }
record NoteRefusalMoved { revision: u32 }
enum NoteRefusal { busy, oversized, full, exists, missing, moved: NoteRefusalMoved, revision_exhausted }
record CallPartNoteRefused { value: NoteRefusal }
enum CallPart { effect: CallPartEffect, connector: CallPartConnector, effect_denied: CallPartEffectDenied, tool_denied: CallPartToolDenied, escalation_decided: CallPartEscalationDecided, escalation_refused: CallPartEscalationRefused, proposed: CallPartProposed, proposal_decided: CallPartProposalDecided, proposal_refused: CallPartProposalRefused, controlled, control_refused: CallPartControlRefused, control_denied: CallPartControlDenied, sent: CallPartSent, introduced, message_refused: CallPartMessageRefused, subscribed: CallPartSubscribed, unsubscribed, subscription_refused: CallPartSubscriptionRefused, delegated: CallPartDelegated, delegation_denied: CallPartDelegationDenied, delegation_refused: CallPartDelegationRefused, note_written: CallPartNoteWritten, note_recalled: CallPartNoteRecalled, note_refused: CallPartNoteRefused, unavailable }
record CallRecord { key: CallKey part: CallPart settled: option SettledCall }
enum Value { call: CallRecord }
versioned record Row { value: Value }
