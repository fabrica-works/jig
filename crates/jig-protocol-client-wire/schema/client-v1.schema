family jig-client-wire 1

# Envelopes carry the owner version; each end checks its served range.
record Family { number: u16 }
enum Owner { jig, family: Family }
record Keyed { key: fixed 16 owner: Owner version: u32 request: bytes 1048576 }
record Owned { owner: Owner version: u32 record: bytes 16777216 }
enum Answer { final_answer: Owned, busy, not_ready, signed_out }
record LinkSignIn { secret: bytes 64 }
# 30.1 keeps the bearer field as bytes; 31.1 changes it to secret.
record SignedIn { token: bytes 48 party: u64 expires: u64 }
enum SignInAnswer { signed_in: SignedIn, refused }
record SignOut {}
enum SignOutAnswer { signed_out }

# document_text.rs
# DocumentText.bytes: jig_domain_client::Limits::text
record DocumentText { bytes: text 65536 cut: bool }
# common.rs
record ExecutorAgent { charter: u32 }
record ExecutorProcedure { connector: u16 kind: u32 }
record ExecutorParty { party: u64 }
record ExecutorRole { project: u32 role: u32 }
enum Executor { agent: ExecutorAgent, procedure: ExecutorProcedure, party: ExecutorParty, role: ExecutorRole }
# common.rs
enum Phase { waiting, idle, due, preparing, claimed, running, backing_off, active, closing, held, ended, done, failed, cancelled }
# run_facts.rs
record RunStageClaimed { attempt: u64 }
record RunStageRunning { attempt: u64 }
record RunStageBackingOff { until: u64 }
enum RunStage { idle, due, preparing, claimed: RunStageClaimed, running: RunStageRunning, backing_off: RunStageBackingOff }
# owner_part.rs
record PersonAddressParty { value: u64 }
record PersonAddressRole { value: u32 }
enum PersonAddress { party: PersonAddressParty, role: PersonAddressRole }
# run_facts.rs
record ClosingStageRun { attempt: u64 }
enum ClosingStage { run: ClosingStageRun, delegates, effects, releases, settled }
# refusals.rs
enum HoldFailure { transient, permanent, run, agent, lost, invalid }
# refusals.rs
record HoldCategoryFailures { class: HoldFailure }
record HoldCategoryDependency { task: u64 }
record HoldCategoryStoppedBy { party: u64 }
record HoldCategoryUncertain { entry: u64 }
record HoldCategoryPoolLost { pool: u64 }
enum HoldCategory { failures: HoldCategoryFailures, stalled, dependency: HoldCategoryDependency, stopped, stopped_by: HoldCategoryStoppedBy, drift, effects, effect_failed, uncertain: HoldCategoryUncertain, budget, deadline, holds_waited, resource_unavailable, resource_access, pool_lost: HoldCategoryPoolLost, procedure }
# chip_phase.rs
# OwnerChipPhaseWaiting.dependencies: jig_domain_client::Limits::rows
record OwnerChipPhaseWaiting { dependencies: list 32 u64 more: bool holds: bool }
record OwnerChipPhaseActive { value: RunStage }
record OwnerChipPhasePerson { address: PersonAddress taken_by: option u64 since: option u64 }
record OwnerChipPhaseClosing { value: ClosingStage }
record OwnerChipPhaseHeld { reason: HoldCategory revision: u64 }
enum OwnerChipPhase { waiting: OwnerChipPhaseWaiting, active: OwnerChipPhaseActive, person: OwnerChipPhasePerson, closing: OwnerChipPhaseClosing, held: OwnerChipPhaseHeld, ended }
# documents.rs
enum FailureClass { host_lost, temporary, permanent, stall }
# run_facts.rs
record RetryNoticeOwnerFailed { class: HoldFailure count: u32 allowance: u32 }
record RetryNoticeFailed { class: FailureClass count: u32 allowance: u32 }
record RetryNoticeRefused { count: u32 }
enum RetryNotice { owner_failed: RetryNoticeOwnerFailed, failed: RetryNoticeFailed, refused: RetryNoticeRefused }
# live_call.rs
# CallIdentity.id: jig_domain_client::Limits::text
record CallIdentity { owner: u64 sequence: u32 retry: u32 id: text 65536 }
# run_facts.rs
# RunWorkTool.tool: jig_domain_client::Limits::text
record RunWorkTool { call: CallIdentity tool: text 65536 }
enum RunWork { preparing, starting, active, writing, tool: RunWorkTool, waiting, ending }
# run_facts.rs
record RunObservation { channel: u64 work: RunWork since: u64 reported_at: u64 started: option u64 }
# run_facts.rs
record ActiveRun { stage: RunStage phase_since: u64 attempt: option u64 placement: option u64 retry: option RetryNotice observation: option RunObservation }
# common.rs
record ProposerTask { value: u64 }
record ProposerParty { value: u64 }
enum Proposer { task: ProposerTask, party: ProposerParty }
# common.rs
record ProposalKey { proposer: Proposer number: u64 }
# common.rs
record PartScopeProject { value: u32 }
enum PartScope { project: PartScopeProject, deployment }
# common.rs
record PartConnector { connector: u16 }
# PartResource.path: jig_domain_client::Limits::rows
# PartResource.path: jig_domain_client::Limits::text
record PartResource { connector: u16 path: list 32 bytes 65536 }
record PartKind { connector: u16 kind: u16 }
record PartPanel { connector: u16 task: u64 }
record PartResult { connector: u16 task: u64 }
record PartEffect { connector: u16 proposal: ProposalKey }
record PartOwnerEffect { connector: u16 proposal: u64 }
record PartOutbox { connector: u16 scope: PartScope entry: u64 }
record PartHold { connector: u16 task: u64 }
record PartProject { connector: u16 project: u32 }
record PartDeployment { connector: u16 }
enum Part { connector: PartConnector, resource: PartResource, kind: PartKind, panel: PartPanel, result: PartResult, effect: PartEffect, owner_effect: PartOwnerEffect, outbox: PartOutbox, hold: PartHold, project: PartProject, deployment: PartDeployment }
# asks.rs
