# documents.rs
record ResultValueReportFields { value: DocumentText }
# ResultValueOwnerVerdictFields.fields: jig_domain_client::Limits::rows
record ResultValueOwnerVerdictFields { verdict: u32 words: DocumentText fields: list 32 ResultField }
# ResultValueVerdictFields.fields: jig_domain_client::Limits::rows
# ResultValueVerdictFields.tasks: jig_domain_client::Limits::rows
record ResultValueVerdictFields { verdict: u32 words: DocumentText fields: list 32 ResultField tasks: list 32 u32 proposal: option ProposalKey }
record ResultValueConnectorFields { summary: DocumentText part: Part }
record ResultValueChangeFields { kind: u16 part: OwnerPart words: DocumentText }
record ResultValueChoiceFields { option: u32 by: Party reason: DocumentText }
record ResultValueApprovedFields { state: bytes 65536 words: option DocumentText }
record ResultValueFailureFields { value: DocumentText }
record ResultValueWordsFields { value: DocumentText }
enum ResultValueFields { report: ResultValueReportFields, owner_verdict: ResultValueOwnerVerdictFields, verdict: ResultValueVerdictFields, connector: ResultValueConnectorFields, change: ResultValueChangeFields, choice: ResultValueChoiceFields, approved: ResultValueApprovedFields, failure: ResultValueFailureFields, words: ResultValueWordsFields }
record ResultValueRow { parent: option u32 value: ResultValueFields }
enum Fact { chip: ChipRow, chip_phase: ChipPhaseRow, closing: ClosingRow, ending: EndingRow, held_runtime: HeldRuntimeRow, hold_reason: HoldReasonRow, owner_chip_details: boxed OwnerChipDetailsRow, owner_chip_ending: OwnerChipEndingRow, result_value: ResultValueRow }
# Recursive facts share one ordered table. Its first row is the named root.
# A row parent and every recursive field are indexes in that same table.
# Parents precede their children; list indexes preserve the supplied order.
# Unbounded fact row ceiling halved from 256 until its wire worst case fits u32.
record Chip { rows: list 32 Fact }
record ChipPhase { rows: list 32 Fact }
record Closing { rows: list 32 Fact }
record Ending { rows: list 32 Fact }
record HeldRuntime { rows: list 32 Fact }
record HoldReason { rows: list 32 Fact }
record OwnerChipDetails { rows: list 32 Fact }
record OwnerChipEnding { rows: list 32 Fact }
record ResultValue { rows: list 32 Fact }
