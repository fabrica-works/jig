# OwnerPartKeyPath.value: jig_domain_client::Limits::text
record OwnerPartKeyPath { value: list 32 bytes 65536 }
record OwnerPartKeyNumber { value: u64 }
enum OwnerPartKey { path: OwnerPartKeyPath, number: OwnerPartKeyNumber }
# owner_part.rs
record OwnerPart { connector: u16 kind: OwnerPartKind key: OwnerPartKey }
# owner_chip.rs
record OwnerPriorPhaseActive { value: RunStage }
record OwnerPriorPhaseClosing { value: ClosingStage }
enum OwnerPriorPhase { waiting, active: OwnerPriorPhaseActive, closing: OwnerPriorPhaseClosing }
# owner_chip.rs
record OwnerEscalationHolderTask { value: u64 }
record OwnerEscalationHolderPerson { value: u64 }
record OwnerEscalationHolderRole { project: u32 role: u32 }
enum OwnerEscalationHolder { task: OwnerEscalationHolderTask, person: OwnerEscalationHolderPerson, role: OwnerEscalationHolderRole }
# owner_chip.rs
record OwnerHoldEscalationWaiting { holder: OwnerEscalationHolder entry: u64 since: u64 }
record OwnerHoldEscalationRejected { by: u64 reason: DocumentText }
enum OwnerHoldEscalation { routing, waiting: OwnerHoldEscalationWaiting, rejected: OwnerHoldEscalationRejected }
# owner_chip.rs
record OwnerFailureTries { transient: u32 permanent: u32 run: u32 agent: u32 lost: u32 invalid: u32 }
# owner_chip.rs
record OwnerChipHold { account: option OwnerPart source: option OwnerPart reason: HoldCategory revision: u64 before: OwnerPriorPhase escalation: option OwnerHoldEscalation tries: OwnerFailureTries hold_wait_since: option u64 }
# owner_budget.rs
record OwnerNumbers { budget: u64 spent: u64 spent_below: u64 reserved: u64 }
# proposed_task.rs
record FunderTask { value: u64 }
record FunderPool { project: u32 person: u64 period: u64 }
record FunderRecurring { project: u32 task: u64 period: u64 }
record FunderPeriod { project: u32 period: u64 }
enum Funder { task: FunderTask, pool: FunderPool, recurring: FunderRecurring, period: FunderPeriod }
# owner_budget.rs
record OwnerBudget { numbers: OwnerNumbers left: u64 funder: Funder deadline: option u64 }
# owner_chip.rs
record OwnerResourceWriterRun { task: u64 attempt: u64 }
record OwnerResourceWriterEffect { entry: u64 }
enum OwnerResourceWriter { run: OwnerResourceWriterRun, effect: OwnerResourceWriterEffect }
# owner_chip.rs
record OwnerResourceLine { part: OwnerPart kind: u16 taken: bool holder: option u64 writer: option OwnerResourceWriter writer_lost: bool }
