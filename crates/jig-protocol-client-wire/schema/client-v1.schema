enum Ask { start_chat: StartChat, write: Write, answer_question: AnswerQuestion, answer_person: AnswerPerson, take: Take, hand_back: HandBack, decide_proposal: DecideProposal, decide_escalation: DecideEscalation, release: Release, amend: boxed Amend, stop: Stop, cancel: Cancel, close: Close, take_over: TakeOver, set_goal: SetGoal, prioritise: Prioritise, mark_seen: MarkSeen, edit_note: EditNote, delete_note: DeleteNote, change_policy: ChangePolicy, set_roles: SetRoles, make_service: MakeService, set_pool: SetPool }
# owner_outcome.rs
enum OwnerProposalChoice { accepted, rejected, passed, withdrawn, stale }
# owner_outcome.rs
enum OwnerEscalationChoice { released, rejected, passed }
# owner_outcome.rs
record OwnerOutcomeClosing { chat: u64 cancelled: u32 kept: u32 }
record OwnerOutcomeMarkedSeen { seen: Seen }
record OwnerOutcomeNoteEdited { name: u64 }
record OwnerOutcomeServiceMade { person: u64 }
record OwnerOutcomeAdopted { project: u32 }
record OwnerOutcomeGoalStarted { task: u64 }
record OwnerOutcomeGoalProposed { proposal: u64 }
record OwnerOutcomeStopped { task: u64 }
record OwnerOutcomeCancelled { task: u64 }
record OwnerOutcomeReleased { task: u64 }
record OwnerOutcomePersonTaken { task: u64 }
record OwnerOutcomePersonHandedBack { task: u64 }
record OwnerOutcomePersonAnswered { task: u64 }
record OwnerOutcomeMoved { task: u64 }
record OwnerOutcomeProposalDecided { proposal: ProposalKey by: u64 at: u64 choice: OwnerProposalChoice }
record OwnerOutcomeSaid { task: u64 message: u64 released: bool }
record OwnerOutcomeQuestionAnswered { task: u64 question: u64 message: u64 }
record OwnerOutcomePrioritised { project: u32 }
record OwnerOutcomeAmended { task: u64 released: bool }
record OwnerOutcomeAmendProposed { task: u64 proposal: u64 released: bool }
record OwnerOutcomeRolesSet { project: u32 }
record OwnerOutcomePolicyChanged { project: u32 }
record OwnerOutcomePoolSet { project: u32 person: u64 }
record OwnerOutcomeEscalationDecided { task: u64 revision: Revision by: u64 at: u64 choice: OwnerEscalationChoice }
record OwnerOutcomeStarted { task: u64 }
enum OwnerOutcome { closing: OwnerOutcomeClosing, marked_seen: OwnerOutcomeMarkedSeen, note_edited: OwnerOutcomeNoteEdited, service_made: OwnerOutcomeServiceMade, adopted: OwnerOutcomeAdopted, goal_started: OwnerOutcomeGoalStarted, goal_proposed: OwnerOutcomeGoalProposed, stopped: OwnerOutcomeStopped, cancelled: OwnerOutcomeCancelled, released: OwnerOutcomeReleased, person_taken: OwnerOutcomePersonTaken, person_handed_back: OwnerOutcomePersonHandedBack, person_answered: OwnerOutcomePersonAnswered, moved: OwnerOutcomeMoved, proposal_decided: OwnerOutcomeProposalDecided, said: OwnerOutcomeSaid, question_answered: OwnerOutcomeQuestionAnswered, prioritised: OwnerOutcomePrioritised, amended: OwnerOutcomeAmended, amend_proposed: OwnerOutcomeAmendProposed, roles_set: OwnerOutcomeRolesSet, policy_changed: OwnerOutcomePolicyChanged, pool_set: OwnerOutcomePoolSet, escalation_decided: OwnerOutcomeEscalationDecided, started: OwnerOutcomeStarted }
# asks.rs
record MadeChat { task: u64 }
record MadeWords { task: u64 message: u64 }
record MadeGoal { task: u64 }
# MadeTasks.tasks: jig_domain_client::Limits::rows
record MadeTasks { tasks: list 32 u64 }
record MadeService { party: u64 }
record MadePersonResult { task: u64 }
record MadeNote { note: u64 scope: NoteScope }
enum Made { chat: MadeChat, words: MadeWords, goal: MadeGoal, tasks: MadeTasks, service: MadeService, person_result: MadePersonResult, note: MadeNote }
# asks.rs
record OutcomeOwner { value: OwnerOutcome }
record OutcomeMade { what: Made }
record OutcomeProposed { proposal: ProposalKey }
record OutcomeDecided { by: Actor how: Decision at: u64 }
record OutcomeDecidedFirst { by: Party how: Decision at: u64 }
enum Outcome { owner: OutcomeOwner, made: OutcomeMade, proposed: OutcomeProposed, decided: OutcomeDecided, decided_first: OutcomeDecidedFirst, changed }
# refusals.rs
enum DisposalIssue { missing, unknown, repeated }
# common.rs
record Grant { connector: u16 kind: u16 pattern: OwnerPattern }
# refusals.rs
record LackingBudget { needed: u64 left: u64 }
record LackingGrant { value: Grant }
record LackingGrantKind { kind: u16 }
record LackingAgain { required: bool }
record LackingRequired { connector: u16 kind: u16 }
record LackingFailed { connector: u16 kind: u16 }
record LackingUnguarded { connector: u16 kind: u16 }
record LackingTaskKind { executor: option Executor }
record LackingDepth { needed: option u32 allowed: u32 }
record LackingDeadline { asked: option u64 latest: option u64 }
record LackingTasks { needed: option u32 left: u32 }
enum Lacking { approver, budget: LackingBudget, grant: LackingGrant, grant_kind: LackingGrantKind, funding, tool, scope, reference, resource_access, resource_unavailable, shape, again: LackingAgain, account, writer, required: LackingRequired, failed: LackingFailed, unguarded: LackingUnguarded, task_kind: LackingTaskKind, depth: LackingDepth, deadline: LackingDeadline, tasks: LackingTasks }
# admission_limits.rs
enum AdmissionLimit { words, identity, roles, arithmetic, duplicate, empty, batch, project_live_tasks, live_tasks, tree, depth, delegates, subscription, dependencies, cycle, spec, contract, authority, inputs, attempts, live_delegates, restore, read, turn, hold_kind, hold_taken, holds, inbox_full, notes, revision, question, priority, policy, resource, service }
# refusals.rs
record LimitAdmission { which: AdmissionLimit }
record LimitLiveTasks { project: u32 limit: u32 }
record LimitInbox { task: u64 limit: u32 }
record LimitWords { limit: u32 }
record LimitConversationWords { limit: u32 }
enum Limit { admission: LimitAdmission, live_tasks: LimitLiveTasks, inbox: LimitInbox, words: LimitWords, conversation_words: LimitConversationWords, fields, records, requests, reads, watches, objects }
# refusals.rs
record CurrentHoldDocument { value: HoldReason }
record CurrentHoldReason { value: HoldCategory }
enum CurrentHold { document: CurrentHoldDocument, reason: CurrentHoldReason }
# refusals.rs
record MovedHold { reason: option CurrentHold }
enum Moved { hold: MovedHold, spec, person_task, note, waiting }
# refusals.rs
record RefusalRole { held: option HeldRole }
record RefusalDisposal { task: u64 issue: DisposalIssue }
record RefusalTaken { by: u64 }
record RefusalAuthority { lacking: Lacking proposable: option bool }
record RefusalLimit { which: Limit }
record RefusalMoved { now: Revision what: Moved }
record RefusalEnded { how: Ending }
enum Refusal { role: RefusalRole, disposal: RefusalDisposal, taken: RefusalTaken, not_waiting, no_further, authority: RefusalAuthority, limit: RefusalLimit, moved: RefusalMoved, ended: RefusalEnded, unknown, not_offered, key_conflict }
record Done { outcome: Outcome }
record Refused { refusal: Refusal }
enum Final { done: Done, refused: Refused }
# Reads keep the engine's cursor opaque (protocol/client.md, section 6).
record Cursor { value: bytes 1024 }
enum InboxReadGroup { needs, updates }
enum InboxGroup { questions, proposals, escalations, person_tasks, results, replies }
record ReadTask { task: u64 }
record ReadProposal { proposal: ProposalKey }
record ReadEscalation { task: u64 }
record ReadQuestion { task: u64 message: u64 }
record ReadPersonTask { task: u64 }
record ReadResult { task: u64 }
record ReadEnded { task: u64 after: option Cursor }
record ReadHistory { task: u64 subtree: bool after: option Cursor }
record ReadActivity { task: u64 before: option Cursor }
record ReadInbox { group: InboxReadGroup project: option u32 kind: option InboxGroup goal: option u64 after: option Cursor }
record ReadConversations { after: option Cursor }
record ReadGoals { project: u32 after: option Cursor }
record ReadSpend { project: u32 after: option Cursor }
record ReadProject { project: u32 }
# ReadNotes.description: jig_domain_client::Limits::text
record ReadNotes { scope: NoteScope description: option text 65536 after: option Cursor }
enum Read { frame, task: ReadTask, proposal: ReadProposal, escalation: ReadEscalation, question: ReadQuestion, person_task: ReadPersonTask, result: ReadResult, ended: ReadEnded, history: ReadHistory, activity: ReadActivity, inbox: ReadInbox, conversations: ReadConversations, goals: ReadGoals, spend: ReadSpend, project: ReadProject, notes: ReadNotes, deployment }
# Unreachable is a local connection outcome; the engine sends no such record.
enum ReadNone { unknown, refused, gone, busy, signed_out }
record ReadAnswerNone { value: ReadNone }
enum ReadAnswer { value: Owned, none: ReadAnswerNone }
# Flat retained funding rows (contract/historical_pages.rs).
record OwnerPeriodTimes { began: u64 next: option u64 }
record OwnerFundingRecord { period: option OwnerPeriodTimes funder: Funder parent: option Funder numbers: OwnerNumbers made: u32 closed: bool }
# OwnerSpendPage.rows: jig_domain_client::Limits::rows
record OwnerSpendPage { rows: list 32 OwnerFundingRecord before: option Cursor after: option Cursor cut: bool }
