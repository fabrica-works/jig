record HoldReasonProcedureFields { part: Part }
enum HoldReasonFields { tries: HoldReasonTriesFields, stalled: HoldReasonStalledFields, dependency: HoldReasonDependencyFields, drift: HoldReasonDriftFields, effect_failed: HoldReasonEffectFailedFields, effect_uncertain: HoldReasonEffectUncertainFields, budget: HoldReasonBudgetFields, deadline: HoldReasonDeadlineFields, stopped: HoldReasonStoppedFields, resource: HoldReasonResourceFields, pool: HoldReasonPoolFields, procedure: HoldReasonProcedureFields }
