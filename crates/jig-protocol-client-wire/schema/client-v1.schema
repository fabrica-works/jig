record ChipPhaseBackingOffFields { at: u64 attempt: u64 tries: u32 class: FailureClass reason: text 65536 }
record ChipPhaseProcedureFields { panel: Part }
record ChipPhasePersonFields { addressed: Recipient taken: option TakenBy since: option u64 }
record ChipPhaseClosingFields { value: u32 }
record ChipPhaseHeldFields { reason: u32 since: u64 revision: Revision was: option u32 }
record ChipPhaseEndedFields { how: u32 at: u64 }
enum ChipPhaseFields { owner: ChipPhaseOwnerFields, active: ChipPhaseActiveFields, waiting: ChipPhaseWaitingFields, idle: ChipPhaseIdleFields, starting, running: ChipPhaseRunningFields, waiting_for_words: ChipPhaseWaitingForWordsFields, backing_off: ChipPhaseBackingOffFields, procedure: ChipPhaseProcedureFields, person: ChipPhasePersonFields, closing: ChipPhaseClosingFields, held: ChipPhaseHeldFields, ended: ChipPhaseEndedFields }
record ChipPhaseRow { parent: option u32 value: ChipPhaseFields }
