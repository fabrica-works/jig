# EndingWithdrawnFields.reason: jig_domain_client::Limits::text
record EndingWithdrawnFields { reason: text 65536 }
record EndingDecidedFields { by: u64 party: option Party how: option Decision at: u64 }
enum EndingFields { task: EndingTaskFields, done, failed: EndingFailedFields, cancelled: EndingCancelledFields, withdrawn: EndingWithdrawnFields, decided: EndingDecidedFields, deleted }
record EndingRow { parent: option u32 value: EndingFields }
