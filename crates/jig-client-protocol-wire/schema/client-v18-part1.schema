# Settings and the closed messages that carry them (protocol/client.md, 3).
record SettingNumber { number: u32 }
enum Setting { charter: SettingNumber, template: SettingNumber, policy: SettingNumber, rules }
record SettingModel { dialect: u32 endpoint: u32 program: option text 32 name: text 4096 window: u32 output: u32 input_price: u64 cached_price: u64 cache_write_price: option u64 output_price: u64 price_unit: u32 efforts: list 16 text 32 effort: option text 32 }
enum SettingHosts { workers, engine, both }
record Charter { number: u32 instructions: text 1114240 waiting: duration resume: bool turns: u32 time: duration reserve_turns: u32 reserve_time: duration model: SettingModel alternatives: list 16 SettingModel inspect: bool modify: bool shell: bool agents: bool call_timeout: duration hosts: SettingHosts spend: u64 }
record SettingPolicy { escalation_role: option u32 ceiling: OwnerAuthority projections: list 32 OwnerGrant period_spend: u64 roles: list 32 PolicyEditRole requirements: list 32 PolicyRequirement permissions: list 32 PolicyPermission templates: list 16 TemplateOverride }
record Rules { ceiling: OwnerAuthority period_spend: u64 minimum_run_spend: u64 maximum_run_spend: u64 implies: list 32 OwnerKindImplication requirements: list 32 PolicyRequirement }
enum SettingValue { charter: boxed Charter, template: boxed Template, policy: boxed SettingPolicy, rules: boxed Rules }
record SettingSet { value: SettingValue }
enum SettingEdit { set: SettingSet, removed, reset }
record SettingItem { setting: Setting edit: SettingEdit }
enum Running { stays, moves }
# items holds length-prefixed SettingItem records, at most 1024.
record ChangeSettings { against: u32 items: bytes 1114240 running: Running }
record OutcomeSettingsChanged { revision: u32 }
record RefusalStale { newest: u32 }
record RefusalFull { revision: u32 tasks: list 32 u64 more: u32 }
enum SettingFault { shape, count, reference, rules, budget, grace, owner }
record MalformedSettings { setting: Setting fault: SettingFault }
record ReadSetting { setting: Setting revision: u32 }
record ReadRevision { number: u32 }
record ReadRevisions { before: option u32 }
enum SettingFollows { default, change }
record SettingLine { setting: Setting name: option DocumentText follows: SettingFollows last: u32 }
record RevisionParty { number: u64 }
enum RevisionDecider { first_start, release, party: RevisionParty }
record RevisionHead { number: u32 against: u32 at: u64 by: RevisionDecider proposal: option ProposalKey moved: bool }
record HeldRevision { head: RevisionHead holders: u32 }
record SettingsProposal { proposer: Proposer number: u32 }
record SettingsDocument { newest: u32 settings: list 32 SettingLine held: list 32 HeldRevision pending: list 32 SettingsProposal }
record SettingDocument { setting: Setting revision: u32 value: SettingValue }
record Size { bytes: u64 }
enum RevisionEdit { set: SettingSet, too_large: Size, removed, reset }
record RevisionItem { setting: Setting edit: RevisionEdit }
# items holds length-prefixed RevisionItem records, at most 1024.
record RevisionDocument { head: RevisionHead items: bytes 16777216 }
record RevisionForgotten { oldest: u32 }
enum RevisionAnswer { revision: RevisionDocument, forgotten: RevisionForgotten, unknown }
record ReadRevisionAnswer { value: RevisionAnswer }
enum RevisionItemEdit { set, removed, reset }
record RevisionItemHead { setting: Setting edit: RevisionItemEdit }
record RevisionRow { head: RevisionHead items: list 32 RevisionItemHead more: u32 }
record RevisionsPage { rows: list 32 RevisionRow next: option u32 forgotten: bool }
enum Outcome { owner: OutcomeOwner, made: OutcomeMade, proposed: OutcomeProposed, decided: OutcomeDecided, decided_first: OutcomeDecidedFirst, changed, settings_changed: OutcomeSettingsChanged }
enum Malformed { project_mismatch, two_as_allowed, conversation_not_agent, cycle, proposed_as_allowed, ended_by, name: MalformedName, settings: MalformedSettings, settings_unchanged }
record RefusalMalformed { at: u32 why: Malformed }
enum Refusal { malformed: RefusalMalformed, role: RefusalRole, taken: RefusalTaken, not_waiting, no_further, authority: RefusalAuthority, limit: RefusalLimit, moved: RefusalMoved, ended: RefusalEnded, unknown, not_offered, key_conflict, no_escalation_holder, llm: RefusalLlm, provider, account: RefusalAccount, circle: RefusalCircle, dependency: RefusalDependency, kept: RefusalKept, name_taken, account_move: RefusalAccountMove, stale: RefusalStale, full: RefusalFull }
record Done { outcome: Outcome }
record Refused { refusal: Refusal at: option u32 }
enum Final { done: Done, refused: Refused }
enum Read { tasks: ReadTasks, me, task: ReadTask, proposal: ReadProposal, escalation: ReadEscalation, question: ReadQuestion, person_task: ReadPersonTask, result: ReadResult, ended: ReadEnded, history: ReadHistory, activity: ReadActivity, inbox: ReadInbox, spend: ReadSpend, project: ReadProject, notes: ReadNotes, deployment, turn: ReadTurn, settings, setting: ReadSetting, revision: ReadRevision, revisions: ReadRevisions }
record BeyondRefused { value: Refusal }
enum Beyond { proposed: BeyondProposed, refused: BeyondRefused }
record AdmissionBounded { within: Bounds beyond: Beyond }
record AdmissionRefused { value: Refusal }
enum Admission { allowed, proposed: AdmissionProposed, bounded: boxed AdmissionBounded, refused: AdmissionRefused }
record Offered { act: ActKind admission: Admission effect: option Effect }
record CreatingBounds { within: BoundsCreate beyond: Beyond }
record MeProject { project: u32 name: DocumentText role: HeldRole pool: option PoolLedger templates: bytes 16777216 creating: option CreatingBounds models: list 64 MeModel }
record EntranceRefusal { refusal: Refusal }
enum Ask { message: Message, answer: Answer, take: Take, hand_back: HandBack, decide: Decide, release: Release, amend: boxed Amend, stop: Stop, cancel: Cancel, move_task: Move, seen: Seen, edit_note: EditNote, delete_note: DeleteNote, change_policy: ChangePolicy, set_roles: SetRoles, make_service: MakeService, set_pool: SetPool, compound: Compound, create: Create, propose: Propose, withdraw: Withdraw, sign_in: AskSignIn, sign_out: AskSignOut, account_change: AskAccountChange, rename: Rename, make_project: MakeProject, change_settings: ChangeSettings }
enum ReadValue { tasks: TaskPage, owner_project: OwnerProject, historical: boxed OwnerHistorical, me: Me, task: Task, proposal: Proposal, owner_proposal: OwnerProposal, escalation: Escalation, owner_escalation: OwnerEscalation, question: Question, person_task: PersonTask, owner_person_task: OwnerPersonTask, result: ResultDocument, ended: ObjectPage, owner_ended: OwnerEndedPage, history: HistoryPage, activity: ActivityPage, inbox: InboxPage, owner_inbox: OwnerInboxPage, spend: SpendPage, owner_spend: OwnerSpendPage, project: Project, notes: NotePage, deployment: Deployment, owner_deployment: OwnerDeployment, turn: ArchivedTurn, settings: SettingsDocument, setting: SettingDocument, revision: ReadRevisionAnswer, revisions: RevisionsPage }
enum DeliveryValue { owner_project: OwnerProject, me: Me, task: boxed Task, owner_proposal: OwnerProposal, tree: Tree, owner_tree: OwnerTree, chips: Chips, inbox: Inbox, owner_inbox: OwnerInbox, tasks: Tasks, run: RunText, run_state: RunState, deployment: Deployment, owner_deployment: OwnerDeployment, owner_accounts: OwnerAccounts, settings: SettingsDocument }
