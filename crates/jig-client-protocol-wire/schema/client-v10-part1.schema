record OwnerTaskCapacityActionSource { funder: Funder }
record OwnerTaskCapacityActionIntroduce { left: u64 right: u64 }
record OwnerTaskCapacityActionSubscription { number: u64 }
record OwnerTaskCapacityActionEffect { entry: u64 }
record OwnerTaskCapacityActionClaim { attempt: u64 }
enum OwnerTaskCapacityAction { batch: OwnerTaskCapacityActionBatch, proposal: OwnerTaskCapacityActionProposal, person_proposal: OwnerTaskCapacityActionPersonProposal, message: OwnerTaskCapacityActionMessage, source: OwnerTaskCapacityActionSource, introduce: OwnerTaskCapacityActionIntroduce, subscription: OwnerTaskCapacityActionSubscription, effect: OwnerTaskCapacityActionEffect, claim: OwnerTaskCapacityActionClaim, release, move_task }
record OwnerTaskCapacityCauseTasks { limit: u32 }
record OwnerTaskCapacityCauseCreationFlights { limit: u32 }
record OwnerTaskCapacityCauseResourceReports { limit: u32 }
record OwnerTaskCapacityCauseProjectTasks { limit: u32 }
record OwnerTaskCapacityCauseTree { limit: u32 }
record OwnerTaskCapacityCauseDelegates { limit: u32 }
record OwnerTaskCapacityCauseInbox { task: u64 messages: u32 bytes: u32 }
record OwnerTaskCapacityCauseHoldings { limit: u32 }
record OwnerTaskCapacityCauseHoldWaiters { limit: u32 }
record OwnerTaskCapacityCauseProposals { limit: u32 }
record OwnerTaskCapacityCauseReferences { limit: u32 }
record OwnerTaskCapacityCauseSubscriptions { limit: u32 }
record OwnerTaskCapacityCauseFunders { limit: u32 }
record OwnerTaskCapacityCauseWriters { limit: u32 }
enum OwnerTaskCapacityCause { tasks: OwnerTaskCapacityCauseTasks, creation_flights: OwnerTaskCapacityCauseCreationFlights, resource_reports: OwnerTaskCapacityCauseResourceReports, project_tasks: OwnerTaskCapacityCauseProjectTasks, tree: OwnerTaskCapacityCauseTree, delegates: OwnerTaskCapacityCauseDelegates, inbox: OwnerTaskCapacityCauseInbox, holdings: OwnerTaskCapacityCauseHoldings, hold_waiters: OwnerTaskCapacityCauseHoldWaiters, proposals: OwnerTaskCapacityCauseProposals, references: OwnerTaskCapacityCauseReferences, subscriptions: OwnerTaskCapacityCauseSubscriptions, funders: OwnerTaskCapacityCauseFunders, writers: OwnerTaskCapacityCauseWriters }
record OwnerTaskCapacityRequest { project: option u32 by: OwnerRequester action: OwnerTaskCapacityAction cause: OwnerTaskCapacityCause }
record OwnerTaskCapacityRefusal { request: OwnerTaskCapacityRequest at: u64 }
enum WatchEnd { not_served: NotServed, closed, unknown, not_allowed, busy, subject_ended, signed_out, stopping }
enum WatchRefusal { unknown, not_allowed, busy, signed_out }
record Open { stream: fixed 16 watch: u64 subject: Owned }
record OpenAnswerRefused { why: WatchRefusal }
enum OpenAnswer { not_served: NotServed, admitted, refused: OpenAnswerRefused }
record WatchClose { stream: fixed 16 watch: u64 }
enum CloseAnswer { closed, signed_out }
record Gone { stream: fixed 16 }
record Hello { stream: fixed 16 served: list 16 Served heartbeat: duration }
record Delivery { watch: u64 document: Owned }
record Ended { watch: u64 why: WatchEnd }
record StreamText { watch: u64 value: RunText }
enum StreamEvent { hello: Hello, delivery: Delivery, text: StreamText, ended: Ended }
# Account deadlines follow the optional-wall contract (rulings 190 and 191).
record OwnerAccountStateLater { until: option u64 }
enum OwnerAccountPlace { directory, file }
enum OwnerAccountUnread { unreadable, refused, failed, stalled, too_large }
record OwnerAccountStateUnloaded { at: OwnerAccountPlace why: OwnerAccountUnread }
enum OwnerAccountState { asking, granted, later: OwnerAccountStateLater, sign_in_again, misconfigured, unloaded: OwnerAccountStateUnloaded, cancelled, closing }
record OwnerAccountUseParty { party: u64 }
record OwnerAccountUseProject { project: u32 }
enum OwnerAccountUse { party: OwnerAccountUseParty, project: OwnerAccountUseProject }
record PayerReadiness { provider: u32 payer: OwnerAccountUse readiness: Readiness settled: option bool }
# Account changes share the account documents' payer type and ACCOUNT_USES bound.
record AccountChangeAddKey { provider: u32 join: option u32 digest: fixed 32 }
record AccountChangeReplaceKey { source: u32 digest: fixed 32 }
record AccountChangeRemoveKey { source: u32 }
record AccountChangeResume { source: u32 }
record AccountChangeRemove { account: u32 }
record AccountChangeMoveAccount { account: u32 place: u32 }
record AccountChangeMoveSource { account: u32 source: u32 place: u32 }
record AccountChangeSetUses { account: u32 uses: option list 16 OwnerAccountUse }
enum AccountChange { add_key: AccountChangeAddKey, replace_key: AccountChangeReplaceKey, remove_key: AccountChangeRemoveKey, resume: AccountChangeResume, remove: AccountChangeRemove, move_account: AccountChangeMoveAccount, move_source: AccountChangeMoveSource, set_uses: AccountChangeSetUses }
record AskAccountChange { holder: AccountHolder change: AccountChange }
enum Ask { message: Message, answer: Answer, take: Take, hand_back: HandBack, decide: Decide, release: Release, amend: boxed Amend, stop: Stop, cancel: Cancel, move_task: Move, seen: Seen, edit_note: EditNote, delete_note: DeleteNote, change_policy: ChangePolicy, set_roles: SetRoles, make_service: MakeService, set_pool: SetPool, compound: Compound, create: Create, propose: Propose, withdraw: Withdraw, sign_in: AskSignIn, sign_out: AskSignOut, account_change: AskAccountChange }
record OwnerAccountHolderParty { party: u64 }
enum OwnerAccountHolder { deployment, party: OwnerAccountHolderParty }
enum OwnerAccountKind { sign_in, key, program, none }
enum OwnerAccountBound { accounts, holder_accounts, sources, sign_ins }
enum OwnerAccountKeyFailure { too_long, not_stored }
record OwnerAccountRefusalNotKept { why: OwnerAccountKeyFailure }
record OwnerAccountRefusalLimit { bound: OwnerAccountBound }
record OwnerAccountRefusalHeld { provider: u32 }
record OwnerAccountRefusalProvider { provider: u32 }
record OwnerAccountRefusalKind { kind: OwnerAccountKind }
enum OwnerAccountRefusal { not_limited, uses, not_kept: OwnerAccountRefusalNotKept, limit: OwnerAccountRefusalLimit, held: OwnerAccountRefusalHeld, provider: OwnerAccountRefusalProvider, subject, unknown, numbers, kind: OwnerAccountRefusalKind, closing, not_started }
record OwnerAccountFailureLater { after: option duration }
record OwnerAccountFailureMissingScope { scope: u32 }
record OwnerAccountFailureUnloaded { at: OwnerAccountPlace why: OwnerAccountUnread }
enum OwnerAccountFailure { later: OwnerAccountFailureLater, sign_in_again, missing_scope: OwnerAccountFailureMissingScope, misconfigured, unloaded: OwnerAccountFailureUnloaded, cancelled }
record OwnerAccountEndMade { account: u32 declined: bool }
record OwnerAccountEndRenewed { account: u32 declined: bool }
record OwnerAccountEndRefused { refusal: OwnerAccountRefusal }
record OwnerAccountEndFailed { failure: OwnerAccountFailure }
enum OwnerAccountEnd { made: OwnerAccountEndMade, renewed: OwnerAccountEndRenewed, refused: OwnerAccountEndRefused, failed: OwnerAccountEndFailed }
record OwnerAccountSource { name: option bytes 32 place: u32 number: u32 kind: OwnerAccountKind state: OwnerAccountState usable: bool expiring: bool attention: bool spent_until: option u64 }
record OwnerAccountLine { number: u32 place: u32 uses: option list 16 OwnerAccountUse plan: bool provider: option u32 display: DocumentText holder: OwnerAccountHolder sources: bytes 16777216 cut: bool provider_name: option DocumentText manage_usage: option bytes 2048 }
record OwnerAccountSignIn { source: u32 provider: u32 holder: OwnerAccountHolder }
record OwnerAccountLastEnd { source: u32 end: OwnerAccountEnd }
record OwnerAccounts { program_hosts: bytes 16777216 accounts: bytes 16777216 signing: bytes 16777216 last_end: option OwnerAccountLastEnd usable: bool settled: bool cut: bool readiness: bytes 16777216 readiness_cut: bool }
record OwnerAccount { number: u32 place: u32 uses: option list 16 OwnerAccountUse plan: bool provider: option u32 display: DocumentText holder: OwnerAccountHolder sources: bytes 16777216 generation: option u64 state: OwnerAccountState usable: bool expiring: bool attention: bool spent_until: option u64 runs: bytes 16777216 waiting: bytes 16777216 cut: bool provider_name: option DocumentText manage_usage: option bytes 2048 }
record OwnerDeployment { store: StoreFill hosts: bytes 16777216 attempts: bytes 16777216 accounts: bytes 16777216 tasks: OwnerCapacity workers: OwnerCapacity attempts_capacity: OwnerCapacity waiting_attempts: u32 proposals: OwnerCapacity projects: list 32 OwnerProjectCapacity grace_bound: duration hello_refusals: list 32 OwnerHelloRefusalLine hosts_forgotten: u64 hello_refusals_forgotten: u64 person_room_refusals: list 32 OwnerPersonCapacityRefusal person_room_refusals_forgotten: u64 person_answer_retention: duration task_room_refusals: list 32 OwnerTaskCapacityRefusal task_room_refusals_forgotten: u64 cut: bool connectors: list 32 u16 connectors_cut: bool providers: bytes 16777216 providers_cut: bool key_bytes: u32 readiness: bytes 16777216 readiness_cut: bool }
# Small store (protocol/client.md, 10); TableEntry.request has Keyed.request's ceiling.
versioned record Kept { store_version: u16 record: bytes 65536 }
record TableEntry { asker: u32 number: u64 key: fixed 16 scope: u64 first_sent: option u64 owner: Owner version: u32 request: bytes 1114240 }

# A read value preserves the contract variant as well as its existing document (ruling 208).
enum ReadValue { tasks: TaskPage, owner_project: OwnerProject, historical: boxed OwnerHistorical, me: Me, task: Task, proposal: Proposal, owner_proposal: OwnerProposal, escalation: Escalation, owner_escalation: OwnerEscalation, question: Question, person_task: PersonTask, owner_person_task: OwnerPersonTask, result: ResultDocument, ended: ObjectPage, owner_ended: OwnerEndedPage, history: HistoryPage, activity: ActivityPage, inbox: InboxPage, owner_inbox: OwnerInboxPage, spend: SpendPage, owner_spend: OwnerSpendPage, project: Project, notes: NotePage, deployment: Deployment, owner_deployment: OwnerDeployment, turn: ArchivedTurn }

# Chips.rows and OwnerInbox.needs/updates/selection: jig_client_view::Limits::document_bytes; each item is a length-prefixed piece (rulings 182 and 184).
record Chips { rows: bytes 16777216 }
record OwnerInbox { party: u64 needs: bytes 16777216 updates: bytes 16777216 next: option OwnerInboxCursor cached_needs: u32 cached_updates: Count results_seen: u64 updates_time_complete: bool selection: option bytes 16777216 }

# A delivery preserves its contract variant and the whole document (ruling 211).
enum DeliveryValue { owner_project: OwnerProject, me: Me, task: boxed Task, owner_proposal: OwnerProposal, tree: Tree, owner_tree: OwnerTree, chips: Chips, inbox: Inbox, owner_inbox: OwnerInbox, tasks: Tasks, run: RunText, run_state: RunState, deployment: Deployment, owner_deployment: OwnerDeployment, owner_accounts: OwnerAccounts }
